# systemd unit for the AiScientist console.
#
# Replaces hand-running ./start.sh: keeps the app alive (Restart=always), starts it on
# boot, and gives one-command restarts for the frequent-update workflow:
#     sudo systemctl restart bioagent      # picks up new backend code (frontend is hot)
#     sudo systemctl status  bioagent
#     journalctl -u bioagent -f            # live logs (incl. the code-fingerprint line)
#
# The app stays bound to 127.0.0.1:8800 — nginx (see deploy/nginx/) is the only public face.
# Because the app is a stateful singleton (per-session SSH tunnels to HPC3), a restart drops
# live sessions; users simply reconnect. There is no zero-downtime path for backend changes.
#
# Install (run as a user with sudo on eyeserver):
#     sudo cp deploy/systemd/bioagent.service /etc/systemd/system/bioagent.service
#     # edit User= / paths below if your service account or layout differ
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now bioagent
#
# Config/secrets are read from /data/BioAgent/app/.env by the app itself (load_project_env).
# For the PUBLIC deploy that .env MUST set:  BIOAGENT_SECRET_KEY=<strong-random>  and
# BIOAGENT_PUBLIC_HTTPS=1  (marks session cookies Secure). See deploy/README.md.

[Unit]
Description=AiScientist console (FastAPI/uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# Service account (nologin). AiScientist runs under `aiscientist` (migrated from `bioagent`
# 2026-07-01) — chown /data/BioAgent to this user before enabling. See deploy/public-domain-tls.md.
User=aiscientist
Group=aiscientist
WorkingDirectory=/data/BioAgent/app
# The app loads /data/BioAgent/app/.env on startup; EnvironmentFile is belt-and-suspenders
# for anything read at import time. Comment out if you rely solely on the app's .env loader.
EnvironmentFile=-/data/BioAgent/app/.env
ExecStart=/data/BioAgent/env/bin/python -m bioagent.gateway --host 127.0.0.1 --port 8800
Restart=always
RestartSec=2
# Give in-flight requests a moment to drain on restart.
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
