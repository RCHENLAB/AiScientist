# AiScientist — the ONE configuration reference.
#
# This file documents every environment variable the product reads, with PLACEHOLDER values.
# It is the only place in this repository that shows the shape of a real deployment: hostnames,
# IP addresses, account names and cluster paths are deliberately not written down anywhere else.
#
# Usage:
#   cp configs/aiscientist.example.env .env      # .env is gitignored — never commit it
#   ...then fill in the values for YOUR cluster and host.
#
# Every variable also accepts the legacy BIOAGENT_ prefix in place of AISCIENTIST_ (they are mirrored
# at import by aiscientist.core.config.apply_brand_env_aliases; AISCIENTIST_ wins if both are set),
# so an older .env keeps working unchanged — see CLAUDE.md.
#
# Placeholder convention:  <ANGLE_BRACKETS> = you must supply it.  Values shown without brackets
# are real defaults that work as-is.
#
# ---------------------------------------------------------------------------------------------
# 1. HPC cluster access
# ---------------------------------------------------------------------------------------------
AISCIENTIST_HPC_HOST=<login.your-cluster.example.edu>
AISCIENTIST_HPC_SSH_PORT=22
# Dedicated data-transfer node. Many sites reserve login nodes for logging in and submitting jobs
# — no compute and NO bulk transfer — so file staging (put_file/get_file) opens its own connection
# here instead of riding the login session. It must mount the same $HOME and shared filesystem.
# SSH-KEY login is required (a password session would need a second MFA push). Set empty to stage
# over the login node again.
AISCIENTIST_HPC_TRANSFER_HOST=<transfer.your-cluster.example.edu>

# ---------------------------------------------------------------------------------------------
# 2. Shared storage on the cluster
# ---------------------------------------------------------------------------------------------
# The group/lab share that research data lives under.
AISCIENTIST_LAB_STORAGE=</shared/fs/your_lab>
# UNIX group owning that share (used for `newgrp` when the images/caches live there). Empty = none.
AISCIENTIST_LAB_DATA_GROUP=<your_lab_group>
#
# ONE root holds everything AiScientist owns on the cluster — the container images and model
# weights AND every member's working files, split by lifetime and per-user throughout:
#
#   <root>/Temp/<user>/      per-run process files   -- SWEPT, see AISCIENTIST_TEMP_TTL_DAYS
#   <root>/uploads/<user>/   raw research data       -- never swept
#   <root>/pysrc/<user>/     synced source           -- never swept
#   <root>/bin/<user>/       the staged sweeper      -- never swept
#   <root>/containers/ hf/ envs/ *_model/            -- built assets, never swept
#
# It must be group-writable (2775 + setgid) so each member's session can create its own subdirs.
# See docs/hpc3_storage_layout.md for the layout and docs/hpc3_assets.md for what lives in it.
AISCIENTIST_HPC_SHARED_ROOT=</shared/fs/your_lab/software/AiScientist>
# Age in days after which a <root>/Temp/<user>/<kind>/<entry> dir whose WHOLE subtree has gone
# untouched is deleted. A running job keeps writing, so it can never be swept mid-flight. The
# sweep is submitted as a Slurm batch job, never run on a login node. 0 disables it entirely.
# Personal user directories, uploads/ and pysrc/ are NEVER auto-deleted.
AISCIENTIST_TEMP_TTL_DAYS=3

# ---------------------------------------------------------------------------------------------
# 3. Slurm — GPU (the LLM serve job)
# ---------------------------------------------------------------------------------------------
# The served model is an AWQ INT4 build (~24 GB of weights). It needs a card with room for the
# weights PLUS a KV cache: a 40/80 GB A100 or a 48 GB L40S is comfortable; a 24 GB A30 or 16 GB
# V100 is not. Slurm has no "gres type != X", so pin the type explicitly rather than excluding.
AISCIENTIST_SLURM_PARTITION=gpu
AISCIENTIST_SLURM_ACCOUNT=<your_gpu_charge_account>
AISCIENTIST_SLURM_GRES=gpu:A100:1
AISCIENTIST_SLURM_CPUS_PER_TASK=8
AISCIENTIST_SLURM_MEMORY_GB=32
AISCIENTIST_SLURM_TIME_LIMIT=02:00:00
# Optional node exclude / feature constraint.
# AISCIENTIST_SLURM_EXCLUDE=<node[00-07]>
# AISCIENTIST_SLURM_CONSTRAINT=<feature>
#
# Optional GPU RACE: submit several candidate serve jobs at once and use whichever is ALLOCATED
# FIRST, scancelling the losers — so a session grabs the earliest free card instead of queueing on
# one scarce type. ';'-separated list of `partition,gres[,account]`. Empty = the single
# partition/gres/account above.
# AISCIENTIST_GPU_CANDIDATES=<free-partition,gpu:TYPE:1,free_account;gpu,gpu:A100:1,paid_account>
# Size the job for the SMALLEST node you race for. On HPC3 the idle free-gpu32 RTX6000 cards sit
# on nodes with only 2-3 free CPUs, and MaxMemPerCPU=6G turns 24G into 4 CPUs, so a 4 CPU / 24G job
# never lands there. The vLLM serve job peaks near 12.6G RSS; production uses 3 CPUs / 18G.
#
# By default a race is NOT a preference order — it is first-come. To make list order a preference,
# set AISCIENTIST_GPU_PREFER_SECONDS: a later-listed candidate that starts first is held until the
# earlier ones have queued that long (the free card wins if it frees up within the window, the paid
# one only when the free pool is busy):
# AISCIENTIST_GPU_PREFER_SECONDS=120
# How long a GPU request may queue: at connect, and when a run's serve job expires mid-run and a new
# one is needed (long on purpose: giving up throws away every step the run has done).
# AISCIENTIST_GPU_WAIT_SECONDS=300
# AISCIENTIST_GPU_HEAL_WAIT_SECONDS=1800
#
# Either way: if one candidate is a free/preemptible
# partition with idle cards and the other is a scarce paid one, the free card wins every time and
# every session ends up somewhere it can be preempted. On RCIC HPC3 `free-gpu*` is
# PriorityTier=0 + PreemptMode=CANCEL, so preemption KILLS the serve job mid-run. When the session
# must survive a long run, list ONE non-preemptible paid candidate and accept the queue:
# AISCIENTIST_GPU_CANDIDATES=<gpu,gpu:A100:1,paid_gpu_account>
# Race only across candidates you are equally happy to land on.

# ---------------------------------------------------------------------------------------------
# 4. Slurm — CPU (analysis, run_code, report render, VEP, phenotype, the Temp sweep)
# ---------------------------------------------------------------------------------------------
# The FREE (non-GPU) partition + a non-GPU charge account, so these never burn the scarce GPU pool.
AISCIENTIST_CPU_PARTITION=standard
AISCIENTIST_CPU_ACCOUNT=<your_cpu_charge_account>
AISCIENTIST_RUN_CODE_MEM_GB=64
AISCIENTIST_RUN_CODE_CPUS=8
AISCIENTIST_RUN_CODE_TIME_LIMIT=01:00:00

# ---------------------------------------------------------------------------------------------
# 5. vLLM serving (Singularity container on the GPU node; OpenAI /v1 over an SSH tunnel)
# ---------------------------------------------------------------------------------------------
AISCIENTIST_LLM_BACKEND=vllm
# Qwen3.8-27B INT4 (W4A16). Previous model, kept for rollback: QuantTrio/Qwen3.6-35B-A3B-AWQ with
# the vllm.sif image and AISCIENTIST_VLLM_QUANTIZATION=awq_marlin.
AISCIENTIST_VLLM_MODEL=RedHatAI/Qwen3.8-27B-INT4
# The image + HF weight cache live in the shared area so every user's serve job reads ONE copy.
AISCIENTIST_VLLM_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/vllm-0.28.0.sif
AISCIENTIST_HF_HOME=${AISCIENTIST_HPC_SHARED_ROOT}/hf
# Context length. The model's native max is 262144; Qwen3.8-27B is hybrid-attention (16 of 64
# layers hold a KV cache), so a full 262K context still leaves 6-8x concurrency on one 80-96 GB
# card. Lower it only if your card is genuinely small.
AISCIENTIST_VLLM_MAX_MODEL_LEN=262144
AISCIENTIST_VLLM_GPU_MEM_UTIL=0.92
# Empty = auto-detect from the checkpoint (compressed-tensors INT4). awq_marlin for the 3.6 AWQ.
AISCIENTIST_VLLM_QUANTIZATION=
AISCIENTIST_VLLM_TOOL_PARSER=qwen3_coder
AISCIENTIST_VLLM_REASONING_PARSER=qwen3
# How hard the PI / Critic / writer think (sent as `reasoning_effort`; the Scientist's tool turns
# do not think). REQUIRED for Qwen3.8: at its default it thought ~22k tokens (6-7 min) on the real
# planning prompt and ran past the 600 s call timeout; at "low" a plan takes ~2.5 min and was judged
# slightly BETTER than Qwen3.6's (experiments/plan_vs_exec_ab, 2026-09-25). Qwen3.6 accepts it too.
AISCIENTIST_VLLM_REASONING_EFFORT=low
AISCIENTIST_VLLM_PORT=11434
# Local end of the SSH tunnel. 0 = pick a free port per session (correct for concurrent users).
# Pin it ONLY if an external tool needs a fixed local URL — a fixed port serves ONE session.
AISCIENTIST_LOCAL_TUNNEL_PORT=0
AISCIENTIST_GPU_POLL_SECONDS=20

# ---------------------------------------------------------------------------------------------
# 6. Optional: split the reasoning roles onto a stronger model
# ---------------------------------------------------------------------------------------------
# Overrides the LLM for the PI / Critic / plan-review / exploration / synthesis turns ONLY. The
# Scientist's tool-calling stays on the local vLLM.
#
# DATA BOUNDARY — read before setting: the PI/Critic prompts carry the research question, the
# dataset profile, accepted findings and artifact digests. Patient-derived phenotype/VCF context
# is in that payload, and unlike the Scientist brief it is NOT covered by the data-boundary guard.
# Setting this is an explicit, un-fenced egress decision; every run says so in the console. Use it
# only for a study whose data is cleared to leave, or point it at a self-hosted endpoint (a
# loopback URL here is a role split with NO egress, and is reported as such).
# AISCIENTIST_LAB_LLM_BASE_URL=<https://api.your-provider.example/v1>
# AISCIENTIST_LAB_LLM_MODEL=<model id from your provider's docs — do not guess it>
# AISCIENTIST_LAB_LLM_API_KEY=<key>              # keep out of git
# AISCIENTIST_LAB_LLM_TIMEOUT_SECONDS=120        # the default 20 is tuned for a LOCAL endpoint

# ---------------------------------------------------------------------------------------------
# 7. Offload flags — keep the gateway host a thin router
# ---------------------------------------------------------------------------------------------
# Each is INDEPENDENT and defaults OFF. Turn ONE on, verify, then enable the next. Every path
# falls back in-process on the gateway if the cluster is unreachable, so enabling cannot hard-fail.
#
# Stream uploads straight to <root>/uploads/<user>/ instead of the gateway disk.
AISCIENTIST_UPLOADS_ON_HPC=1
# Folders on the GATEWAY host whose data users may bind by path instead of uploading it (Data menu
# → "Use data on the server", or the offer shown when such a path is pasted into the chat). `:` or
# `,` separated; empty = off. A path must resolve inside one of them (links that lead out are
# refused). With analysis on HPC3, a run copies what it needs to <root>/uploads/<user>/server-data/
# (incremental and resumable; Loupe files, molecule_info.h5 and Cell Ranger working files skipped).
AISCIENTIST_SERVER_DATA_ROOTS=/data/Users/shared
# Ask before binding when a run would copy more than this many GB; refuse above the second.
#AISCIENTIST_SERVER_DATA_CONFIRM_GB=10
#AISCIENTIST_SERVER_DATA_MAX_GB=500
# Run each scanpy step (QC / clustering / DE / enrichment) as a contained CPU Slurm job.
AISCIENTIST_ANALYSIS_ON_HPC=1
# Run each run_code snippet as a contained CPU Slurm job, where --mem is a real cgroup cap.
AISCIENTIST_RUN_CODE_ON_HPC=1
# Render reports (pandoc + XeLaTeX) as a CPU Slurm job instead of installing texlive on the host.
AISCIENTIST_REPORT_ON_HPC=1
# Annotate VCFs with OFFLINE VEP instead of the public REST API (which caps at 500 variants).
AISCIENTIST_VARIANT_ON_HPC=1
# Run the LIRICAL phenotype->disease line on the cluster.
AISCIENTIST_PHENOTYPE_ON_HPC=1
# Run deep_literature (PaperQA) on the cluster, where the pre-built index lives.
AISCIENTIST_PAPERQA_ON_HPC=1
# Allow network inside the contained jobs (default on). 0 to disable.
# AISCIENTIST_SANDBOX_NETWORK=1

# ---------------------------------------------------------------------------------------------
# 8. Container images — built + staged by deploy/<name>/build_and_stage.sh
# ---------------------------------------------------------------------------------------------
AISCIENTIST_ANALYSIS_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/analysis.sif
AISCIENTIST_REPORT_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/report.sif
AISCIENTIST_VEP_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/vep.sif
AISCIENTIST_LIRICAL_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/lirical.sif
AISCIENTIST_SCGPT_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/scgpt.sif
AISCIENTIST_SCGPT_MODEL_DIR=${AISCIENTIST_HPC_SHARED_ROOT}/scgpt_model
# AISCIENTIST_VLREVIEW_ENABLED=1
# AISCIENTIST_VLREVIEW_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/vlreview.sif
# AISCIENTIST_VLREVIEW_MODEL_DIR=${AISCIENTIST_HPC_SHARED_ROOT}/vlreview_model

# ---------------------------------------------------------------------------------------------
# 9. Variant annotation reference data
# ---------------------------------------------------------------------------------------------
# Convention: download each database ONCE into a lab-shared reference dir, mount read-only, and
# reuse it across projects — do not duplicate it under the AiScientist root.
AISCIENTIST_VEP_CACHE_DIR_GRCH38=</shared/reference>/vep_annotation/GRCh38
AISCIENTIST_VEP_CACHE_DIR_GRCH37=</shared/reference>/vep_annotation/GRCh37
AISCIENTIST_VEP_CLINVAR_GRCH38=</shared/reference>/vep_annotation/clinvar_GRCh38.vcf.gz
AISCIENTIST_VEP_CLINVAR_GRCH37=</shared/reference>/vep_annotation/clinvar_GRCh37.vcf.gz
# The .tbi index MUST sit next to each .vcf.gz — VEP's --custom does a Tabix lookup and
# --containall hides every host path that is not an explicit bind.
AISCIENTIST_REF_FASTA_GRCH37=</shared/reference>/vep_annotation/ref/hg19.fa
AISCIENTIST_VEP_FORK=8
AISCIENTIST_VEP_TIME_LIMIT=02:00:00
AISCIENTIST_VEP_PLUGINS=1
# AISCIENTIST_VEP_REVEL_GRCH37=</shared/reference>/vep_annotation/plugins/revel/new_tabbed_revel_grch37.tsv.gz
# Assembly used ONLY when the build cannot be read from the VCF header (it is auto-detected).
# GRCh37 is the right fallback for an ophthalmology lab — most eye/IRD data is on hg19.
# AISCIENTIST_VEP_ASSEMBLY=GRCh37
# OpenSpliceAI, executed INSIDE the VEP image.
AISCIENTIST_SPLICEAI=1
# AISCIENTIST_SPLICEAI_BIN=${AISCIENTIST_HPC_SHARED_ROOT}/envs/openspliceai/bin/openspliceai
# AISCIENTIST_SPLICEAI_MODELS=</shared/reference>/spliceai/OSAI-MANE-10000nt

# ---------------------------------------------------------------------------------------------
# 10. Phenotype (LIRICAL)
# ---------------------------------------------------------------------------------------------
AISCIENTIST_LIRICAL_DATA_DIR=</shared/reference>/lirical/data
AISCIENTIST_LIRICAL_EXOMISER_HG19=</shared/reference>/lirical/exomiser/<release>_hg19
# LIRICAL v2 needs a recent Exomiser release; a pre-2020 one will not load.

# ---------------------------------------------------------------------------------------------
# 11. deep_literature / PaperQA
# ---------------------------------------------------------------------------------------------
# Point the tool at the index a Slurm job pre-built (deploy/paperqa/embed_corpus.slurm) so queries
# REUSE it instead of re-embedding the corpus per call. All five must match what the embed job
# used, or PaperQA silently rebuilds. See deploy/paperqa/RUNBOOK.md.
# AISCIENTIST_PAPERQA_IMAGE=${AISCIENTIST_HPC_SHARED_ROOT}/containers/paperqa.sif
# AISCIENTIST_PAPERQA_ROOT=</shared/fs/your_lab/corpus>
# AISCIENTIST_PAPERQA_PAPERS=</shared/fs/your_lab/corpus>/papers
# AISCIENTIST_PAPERQA_INDEX_DIR=</shared/fs/your_lab/corpus>/index_pubmedbert
# AISCIENTIST_PAPERQA_INDEX_NAME=<index name>
# AISCIENTIST_PAPERQA_MANIFEST=</shared/fs/your_lab/corpus>/manifest.csv
# AISCIENTIST_PAPERQA_EMBEDDING=st-NeuML/pubmedbert-base-embeddings
# AISCIENTIST_PAPERQA_AGENT_TYPE=fake
#
# --- Retrieval breadth (accuracy vs. wall-clock) ---
# PaperQA's own defaults (search_count=8 docs, evidence_k=10 chunks, answer_max_sources=5,
# answer ~200 words) are sized for a handful of PDFs, not a corpus of ~1,700 papers. On a REVERSE
# question ("which genes cause macular atrophy?") the right answer spans a dozen papers, so the
# 5-source gate truncates it and the tool looks like it retrieved the wrong papers. The values
# below are the in-code defaults; set them here only to override.
# Every extra evidence chunk is one more summary-LLM round trip, so raising these trades seconds
# for breadth — measure against a gold set before settling on a number.
# AISCIENTIST_PAPERQA_SEARCH_COUNT=40     # candidate DOCS from the index (tightest gate)
# AISCIENTIST_PAPERQA_EVIDENCE_K=40       # chunks summarized as evidence
# AISCIENTIST_PAPERQA_MAX_SOURCES=20      # sources allowed into the final answer
# AISCIENTIST_PAPERQA_ANSWER_LENGTH="about 500 words. When the answer is a list of genes, rank them by how many independent papers in the context support each one: give at most 10 as the primary list, strongest evidence first, and put everything else under 'also reported'. Every gene symbol you write must appear verbatim in the cited context - never infer, expand or abbreviate a symbol."
# Summarization is embarrassingly parallel; PaperQA ships 4, which leaves the served model idle.
# AISCIENTIST_PAPERQA_CONCURRENCY=12
# 0.0 so the same question returns the same papers — without it "did retrieval improve?" cannot
# be answered, because the run-to-run spread hides the effect of any change.
# AISCIENTIST_PAPERQA_TEMPERATURE=0.0
#
# --- LLM call budget (a reasoning model on the cluster GPU) ---
# Seconds one PaperQA call to the served model may take. PaperQA's own default is 60 s. Qwen3.8's
# answer over ~20 sources does not fit in that, and every timed-out call is re-sent up to 11 times.
# AISCIENTIST_PAPERQA_LLM_TIMEOUT=600
# How hard the model thinks on the calls that write prose (search queries, the answer). Qwen3.8
# takes low / medium / xhigh ("high" is rejected with HTTP 400). "default" sends nothing.
# AISCIENTIST_PAPERQA_REASONING_EFFORT=low
# The per-passage summaries (EVIDENCE_K of them per question). "off" = no thinking at all.
# AISCIENTIST_PAPERQA_SUMMARY_REASONING_EFFORT=off
# PaperQA's budget in seconds for the whole search -> evidence -> answer rollout. When it runs out,
# PaperQA answers from what it has; evidence still being gathered at that moment is lost.
# AISCIENTIST_PAPERQA_AGENT_TIMEOUT=500

# ---------------------------------------------------------------------------------------------
# 12. Gateway host (where the web console runs)
# ---------------------------------------------------------------------------------------------
# Per-user results: <AISCIENTIST_RESULTS_DIR>/<login>/<run_id>/artifacts/. Put it on a big data disk,
# not /home.
AISCIENTIST_RESULTS_DIR=</data/AiScientist/users>
# Expire run checkpoints (<results>/<user>/<run>/work/) after this many days. This is the
# GATEWAY-LOCAL sweep of run bundles — unrelated to AISCIENTIST_TEMP_TTL_DAYS, which is the cluster.
AISCIENTIST_CHECKPOINT_TTL_DAYS=7
# Deployment target used by scripts/sync_deploy.sh + scripts/deploy_interactive.sh. These are the
# ONLY place the real host is written down; the scripts read them from .deploy.env (gitignored).
# DEPLOY_HOST=<gateway.your-domain.example.edu>
# DEPLOY_SSH_PORT=<22>
# DEPLOY_ADMIN_SSH=<ssh-alias-with-sudo>
# DEPLOY_BIND_HOST=<host IP the ingress can reach, or 127.0.0.1 for a local-only bind>
# PUBLIC_HOSTNAME=<aiscientist.your-domain.example.edu>

# ---------------------------------------------------------------------------------------------
# 13. Accounts, login, admin
# ---------------------------------------------------------------------------------------------
# App accounts are SEPARATE from the cluster login: the AiScientist account is identity + history;
# cluster SSH/MFA stays per-session and is NEVER stored. Only a bcrypt hash of the app password
# reaches the database.
#
# One-time setup:
#   sudo apt install -y postgresql
#   sudo -u postgres psql -c "CREATE ROLE bioagent LOGIN PASSWORD '<strong-password>';"
#   sudo -u postgres psql -c "CREATE DATABASE bioagent OWNER bioagent;"
#   pip install -e ".[auth]"
#   aiscientist-admin create-admin <login>      # interactive; the password never hits disk
#
# Defaults to a local SQLite file if unset (dev/laptop).
# AISCIENTIST_DATABASE_URL=postgresql+psycopg://bioagent:<password>@localhost:5432/bioagent
# REQUIRED in prod. Generate with: openssl rand -hex 32
# AISCIENTIST_SECRET_KEY=<long-random-hex-string>
# Set when serving over HTTPS so session cookies are marked Secure.
# AISCIENTIST_PUBLIC_HTTPS=1
#
# First-admin bootstrap — `aiscientist-admin create-admin` is preferred (keeps passwords off disk).
# AISCIENTIST_ADMIN_USER=<login>
# AISCIENTIST_ADMIN_PASSWORD_HASH=<output of: aiscientist-admin hash-password>

# ---------------------------------------------------------------------------------------------
# 14. Self-registration + outbound email
# ---------------------------------------------------------------------------------------------
# Users can create their own account, gated by (1) an allowed email domain and (2) a 6-digit code
# emailed to it. If AISCIENTIST_SMTP_HOST is UNSET the server runs in DEV mode: the code is logged
# and returned to the browser instead of emailed, so signup works locally with no SMTP.
AISCIENTIST_ALLOW_SELF_REGISTER=1
# A base domain also admits its subdomains.
AISCIENTIST_ALLOWED_EMAIL_DOMAINS=<your-institution.edu>
# AISCIENTIST_SMTP_HOST=<smtp.your-relay.example>
# AISCIENTIST_SMTP_PORT=587                       # 587 STARTTLS · 465 implicit TLS · 25 local relay
# AISCIENTIST_SMTP_TLS=starttls                   # starttls | ssl | none
# AISCIENTIST_SMTP_USER=<relay user id>           # omit if the relay allows this host by IP
# AISCIENTIST_SMTP_PASSWORD=<relay password>      # keep out of git
# AISCIENTIST_SMTP_FROM=AiScientist <no-reply@your-institution.edu>

# ---------------------------------------------------------------------------------------------
# 15. Research-loop behaviour
# ---------------------------------------------------------------------------------------------
# Hypothesis-driven exploration. OFF = the plan drafted before any data is seen can be skipped,
# amended or pruned but never EXTENDED. ON = after a step is accepted the PI judges whether the
# result contradicts the plan's premise and, if so, records a falsifiable hypothesis and appends
# the step that tests it. Costs extra LLM turns; MAX_NEW_STEPS is the runaway guard.
AISCIENTIST_HYPOTHESIS_DRIVEN=0
AISCIENTIST_MAX_NEW_STEPS=16
# Multi-cycle research. 1 = plan once, execute, write up. >1 = after each cycle the PI re-plans
# the next from what the data actually said. Each extra cycle is a whole extra plan's worth of GPU
# time; the loop also exits early on its own.
AISCIENTIST_MAX_CYCLES=1
# Per-agent evolving memory (DAG mode). Each specialist reads its private lessons into its brief,
# writes an episode after acting, and distils lessons at end of run. Accumulates ACROSS runs.
AISCIENTIST_AGENT_MEMORY=1
# Run-scope context management: measure the carried findings block against the served window and
# compact it. The decision is arithmetic; the model only writes the digest prose, artifact paths
# are re-attached mechanically, and a round an OPEN hypothesis points at is never folded.
AISCIENTIST_CONTEXT_MANAGEMENT=0
# Skill induction: at end of run, generalize an accepted run_code procedure into a reusable skill.
# Induced skills are NEVER written into the git-tracked skills/ directory — point this at a stable
# path OUTSIDE the repo so they survive a restart. Review them like any other generated code.
AISCIENTIST_SKILL_INDUCTION=0
# AISCIENTIST_INDUCED_SKILLS_DIR=</data/AiScientist/induced_skills>
# Plan size caps (0 = unlimited).
# AISCIENTIST_MAX_STEPS=
# AISCIENTIST_MAX_ROUNDS=

# ---------------------------------------------------------------------------------------------
# 16. Biomni (optional research backend)
# ---------------------------------------------------------------------------------------------
# Default posture is PLAN-ONLY: with EXECUTE unset the pipeline produces capability/tool plans and
# never calls the heavy runtime. RUNTIME=real is strict — if Biomni is not installed the run
# records a clear "not installed" failure, never a faked answer.
AISCIENTIST_BIOMNI_EXECUTE=1
AISCIENTIST_BIOMNI_RUNTIME=real
# real | mock (use mock on a laptop)
# AISCIENTIST_BIOMNI_DATA_PATH=</data/AiScientist/biomni_data>
# AISCIENTIST_BIOMNI_LOAD_DATA_LAKE=0

# ---------------------------------------------------------------------------------------------
# 17. Local development without a cluster
# ---------------------------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works — a local vLLM/SGLang, or a hosted proxy for prototyping.
# AISCIENTIST_LLM_BASE_URL=http://localhost:8000/v1
# AISCIENTIST_LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# AISCIENTIST_LLM_API_KEY=<local-dev-key>
# OPENROUTER_API_KEY=<key>
# OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
